[Unit]
Description=URL Shortener API Server
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory={{APP_DIR}}
ExecStart={{APP_DIR}}/backend/target/release/shortener
Environment="DATABASE_PATH={{APP_DIR}}/data/app.db"
Environment="STATIC_DIR={{APP_DIR}}/dist"
Environment="PUBLIC_PORT={{APP_PORT}}"
Environment="BASE_URL={{BASE_URL}}"
Restart=unless-stopped
RestartSec=5

[Install]
WantedBy=multi-user.target
